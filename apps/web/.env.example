# Copy to .env.local and fill from Firebase console → Project settings → Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kiddotasks-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public app origin (used for PayMongo success/cancel redirects)
NEXT_PUBLIC_APP_URL=https://kiddotasks-app.web.app

# Firebase Admin (server-only) — service account JSON as a single-line string,
# or rely on GOOGLE_APPLICATION_CREDENTIALS / default credentials on Cloud Run.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# PayMongo (server-only secrets; use sk_test_ / pk_test_ in development)
# Obtain from https://dashboard.paymongo.com/developers
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
# Webhook signing secret from PayMongo Dashboard → Webhooks (after you create the endpoint)
PAYMONGO_WEBHOOK_SECRET=
