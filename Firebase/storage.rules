rules_version = '2';

// Firebase Storage rules for Kiddotasks profile photos.
// Objects live under families/{familyId}/...
service firebase.storage {
  match /b/{bucket}/o {
    match /families/{familyId}/{allPaths=**} {
      // Only authenticated parents whose parents/{uid}.familyId matches may
      // read or write family media. Cross-family access is denied.
      function isFamilyParent() {
        return request.auth != null
          && exists(/databases/(default)/documents/parents/$(request.auth.uid))
          && get(/databases/(default)/documents/parents/$(request.auth.uid)).data.familyId == familyId;
      }

      allow read: if isFamilyParent();
      allow write: if isFamilyParent()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isFamilyParent();
    }
  }
}
