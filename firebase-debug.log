[debug] [2026-09-10T12:27:12.111Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kiddotasks-app/rulesets {"name":"projects/kiddotasks-app/rulesets/b0bfb6fa-8115-4899-86df-56f99c67a354","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Helper functions\n    \n    // Check if user is authenticated\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    // Check if user is parent (has parent document)\n    function isParent(uid) {\n      return exists(/databases/$(database)/documents/parents/$(uid));\n    }\n    \n    // Get parent's family ID\n    function getParentFamilyId(uid) {\n      return get(/databases/$(database)/documents/parents/$(uid)).data.familyId;\n    }\n    \n    // Check if child exists and belongs to family\n    function isChildInFamily(childId, familyId) {\n      return get(/databases/$(database)/documents/children/$(childId)).data.familyId == familyId;\n    }\n    \n    // Check if user (parent) belongs to family\n    function parentBelongsToFamily(uid, familyId) {\n      return get(/databases/$(database)/documents/parents/$(uid)).data.familyId == familyId;\n    }\n    \n    // MARK: - Parent Collection (Authentication)\n    \n    match /parents/{uid} {\n      // Parent can read their own document\n      allow read: if isAuthenticated() && request.auth.uid == uid;\n      \n      // Parent can update their own document (limited fields)\n      allow update: if isAuthenticated() && request.auth.uid == uid\n        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastSignInAt']));\n      \n      // Only system can create parents (via auth setup)\n      allow create: if false;\n      allow delete: if false;\n    }\n    \n    // MARK: - Family Collection\n    \n    match /families/{familyId} {\n      // Parent can read if they belong to family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, familyId);\n      \n      // Parent can update if they own the family\n      allow update: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, familyId)\n        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'settings', 'updatedAt']));\n      \n      allow create, delete: if false;\n    }\n    \n    // MARK: - Children Collection\n    \n    match /children/{childId} {\n      \n      // Parent can read children in their family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      // Parent can update child (but not points - that's via Cloud Functions)\n      allow update: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId)\n        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(\n          ['name', 'avatar', 'dateOfBirth', 'updatedAt']));\n      \n      // Child cannot directly read or write their own data\n      allow read, write: if false;\n      \n      allow create: if isAuthenticated() && isParent(request.auth.uid)\n        && parentBelongsToFamily(request.auth.uid, request.resource.data.familyId)\n        && request.resource.data.activePoints == 0\n        && request.resource.data.totalPointsEarned == 0;\n      allow delete: if false;\n    }\n    \n    // MARK: - Tasks Collection\n    \n    match /tasks/{taskId} {\n      \n      // Parent can read tasks in their family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      // Parent can create tasks in their family\n      allow create: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, request.resource.data.familyId)\n        && request.resource.data.createdBy == request.auth.uid;\n      \n      // Parent can update tasks in their family\n      allow update: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      allow delete: if false;  // Tasks should be archived, not deleted\n    }\n    \n    // MARK: - Task Completions\n    \n    match /taskCompletions/{completionId} {\n      \n      // Parent can read completions in their family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      // Child cannot directly create completions (should be via Cloud Function)\n      // Parent can update completions (approval/rejection)\n      allow update: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId)\n        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(\n          ['status', 'approvedAt', 'approvedBy', 'pointsAwarded', 'pointTransactionId', 'notes']));\n      \n      allow create, delete: if false;  // Should be managed by Cloud Functions\n    }\n    \n    // MARK: - Rewards Collection\n    \n    match /rewards/{rewardId} {\n      // Parent can read rewards in their family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      // Parent can create rewards in their family\n      allow create: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, request.resource.data.familyId);\n      \n      // Parent can update rewards (limited fields)\n      allow update: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId)\n        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(\n          ['name', 'description', 'icon', 'pointCost', 'eligibleChildIds', 'requiresApproval', 'isActive', 'updatedAt', 'version']));\n      \n      allow delete: if false;\n    }\n    \n    // MARK: - Reward Claims\n    \n    match /rewardClaims/{claimId} {\n      \n      // Parent can read reward claims in their family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      // Parent can update reward claims (approve/reject)\n      allow update: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId)\n        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(\n          ['status', 'approvedAt', 'approvedBy', 'pointDeductionTransactionId', 'notes']));\n      \n      allow create, delete: if false;  // Should be managed by Cloud Functions or dedicated endpoint\n    }\n    \n    // MARK: - Point Transactions (Audit Trail)\n    \n    match /pointTransactions/{transactionId} {\n      \n      // Parent can read transaction history for their family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      // Only Cloud Functions can create/update transactions\n      allow create, update, delete: if false;\n    }\n    \n    // MARK: - Achievements\n    \n    match /achievements/{achievementId} {\n      \n      // Parent can read achievements in their family\n      allow read: if isAuthenticated() && isParent(request.auth.uid) \n        && parentBelongsToFamily(request.auth.uid, resource.data.familyId);\n      \n      // Only system can create/update\n      allow create, update, delete: if false;\n    }\n    \n    // MARK: - Family codes (co-parent join index)\n    // Maintained only by Cloud Functions (Admin SDK). Clients never access this.\n    match /familyCodes/{code} {\n      allow read, write: if false;\n    }\n\n    // MARK: - Device Tokens (push notifications)\n\n    // The FCM token registry is managed exclusively by Cloud Functions\n    // (registerDeviceToken / unregisterDeviceToken). Clients never read or\n    // write this collection directly — a token can only be registered by its\n    // authenticated owner through the callable, which validates family\n    // membership server-side.\n    match /deviceTokens/{fcmToken} {\n      allow read, write: if false;\n    }\n    \n    // MARK: - Default: Deny all\n    \n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"Firebase/firestore.rules"}]},"createTime":"2026-09-10T12:27:11.995951Z","metadata":{"services":["cloud.firestore"]}}
